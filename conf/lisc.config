/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    LiSC (University of Vienna) profile: Slurm executor and environment modules
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nextflow run . -profile lisc --mode process --input samplesheet.csv --outdir results \
        -c my_paths.config

    Site paths (Python environment, ThermoRawFileParser, MZmine user file) are
    personal and go in your own -c config, for example:

        params.thermorawfileparser = '/path/to/ThermoRawFileParser'
        params.mzmine_user         = '/path/to/user.mzuser'
        process.beforeScript       = 'source /path/to/venv/bin/activate'

    Keep the Nextflow work directory (-w) and NXF_HOME in /lisc/data/work: home
    folders have a small quota.
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'LiSC'
    config_profile_description = 'Life Science Compute Cluster, University of Vienna (Slurm)'
}

executor {
    name              = 'slurm'
    queueSize         = 50
    submitRateLimit   = '10 sec'
    // The shared file system can show a finished job's exit code a little
    // after Slurm drops the job; wait for it instead of failing the task.
    exitReadTimeout   = '10 min'
    queueStatInterval = '30 sec'
    // LiSC moves jobs submitted to 'basic' into sub-partitions (e.g. zen2_0512).
    // Query job status across all partitions; otherwise a running job is not
    // found, and after exitReadTimeout it is reported as killed.
    queueGlobalStatus = true
}

process {
    executor = 'slurm'
    queue    = 'basic'

    withName: 'MZMINE_PROCESS' {
        module = 'mzmine/4.9.14'
        cpus   = 16
        memory = 64.GB
        time   = 12.h
    }
}
