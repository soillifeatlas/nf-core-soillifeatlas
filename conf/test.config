/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for the `test` profile
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Runs apply mode end to end on the tiny bundled fixtures in a few minutes:

        nextflow run soillifeatlas/nf-core-soillifeatlas -profile test,local --outdir results

    The fixtures are synthetic. They check that the pipeline runs; their
    compositions mean nothing biologically.
----------------------------------------------------------------------------------------
*/

includeConfig 'local.config'

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Tiny synthetic fixtures to check that the pipeline runs'

    mode            = 'apply'
    atlas_path      = "${projectDir}/tests/fixtures/tiny/tiny_atlas_bundle"
    soil_intensity  = "${projectDir}/tests/fixtures/tiny/tiny_intensity.parquet"
    soil_mgf        = "${projectDir}/tests/fixtures/tiny/tiny_soil.mgf"
    sample_metadata = "${projectDir}/tests/fixtures/tiny/tiny_sample_metadata.tsv"

    // The tiny MGF is deliberately sparse; loosen matching so features match.
    simper_min_cos           = 0.5
    simper_min_matched_peaks = 2
    treatment_contrast       = ['drought']
}
