{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/soillifeatlas/nf-core-soillifeatlas/main/assets/schema_input.json",
    "title": "soillifeatlas/nf-core-soillifeatlas - sample sheet (process mode)",
    "description": "One row per raw or mzML file. The role column tells the workflow what each injection is for.",
    "type": "array",
    "items": {
        "type": "object",
        "properties": {
            "file": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.([Rr][Aa][Ww]|[Mm][Zz][Mm][Ll])$",
                "errorMessage": "file must be an existing Thermo .raw or .mzML file without spaces in its path"
            },
            "polarity": {
                "type": "string",
                "enum": ["pos", "neg"],
                "errorMessage": "polarity must be 'pos' or 'neg'",
                "meta": ["polarity"]
            },
            "role": {
                "type": "string",
                "enum": ["sample", "pooled_qc", "blank", "extraction_blank", "nist", "standard_cal", "conditioning"],
                "errorMessage": "role must be one of: sample, pooled_qc, blank, extraction_blank, nist, standard_cal, conditioning",
                "meta": ["role"]
            },
            "group": {
                "type": "string",
                "meta": ["group"]
            },
            "batch": {
                "type": "string",
                "meta": ["batch"]
            },
            "dry_mass_g": {
                "type": "number",
                "minimum": 0,
                "meta": ["dry_mass_g"]
            },
            "extract_mg": {
                "type": "number",
                "minimum": 0,
                "meta": ["extract_mg"]
            },
            "spike_ng": {
                "type": "number",
                "minimum": 0,
                "meta": ["spike_ng"]
            },
            "volume_ul": {
                "type": "number",
                "minimum": 0,
                "meta": ["volume_ul"]
            }
        },
        "required": ["file", "polarity", "role"]
    }
}
