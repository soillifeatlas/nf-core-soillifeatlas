nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"
    profile "test"

    // Runs main.nf (not just workflows/apply.nf), so parameter-schema
    // validation and PIPELINE_INITIALISATION are exercised exactly as a user's
    // `nextflow run ... -profile test` would.
    test("-profile test runs apply mode end to end") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/decompose").list().findAll { it.fileName.toString().startsWith('composition_kingdom_') }.size() == 4 },
                { assert path("$outputDir/decompose").list().findAll { it.fileName.toString().startsWith('composition_phylum_') }.size() == 4 },
                { assert path("$outputDir/correct/intensity_l2_is_corrected.parquet").exists() },
                // L3 RIE is off by default (not part of the published method).
                { assert !path("$outputDir/correct/intensity_l3_rie_corrected.parquet").exists() },
                { assert path("$outputDir/diagnostic/top_features_per_phylum.tsv").exists() }
            )
        }
    }

    test("--enable_rie adds the experimental L3 correction") {

        when {
            params {
                outdir     = "$outputDir"
                enable_rie = true
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path("$outputDir/correct/intensity_l3_rie_corrected.parquet").exists() }
            )
        }
    }
}
