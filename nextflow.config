/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    soillifeatlas/soillifeatlas Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options. Apply mode takes the three soil files below; `input`
    // (samplesheet) is reserved for a later multi-sample driver.
    input                      = null
    soil_intensity             = null
    soil_mgf                   = null
    sample_metadata            = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = System.getenv('HOOK_URL')
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true

    // ========================================
    // SCIENTIFIC CONSTANTS — pinned for reproducibility
    // Do not change without updating PINNED_ATLAS_SHA256 in tests too.
    // ========================================

    // Atlas (Zenodo release — DOI + SHA filled in after v0.1.0 deposition)
    atlas_version = 'v0.1.0'
    atlas_doi     = '10.5281/zenodo.XXXXXXX'  // fill after Zenodo deposition
    atlas_sha256  = ''                         // fill after Zenodo deposition
    atlas_path    = null                       // override for offline/air-gapped runs

    // Internal standard: the paper normalises to the PC 15:0–18:1(d7) component
    // of the EquiSPLASH mix.
    IS_reference_compound        = 'PC_15_0_18_1_d7'
    IS_spiked_pmol               = 100.0

    // Relative ionisation efficiency (L3) correction. Experimental and OFF:
    // the recovery/absolute-scale correction was tested on ClimGrass on
    // 2026-10-16, changed nothing, and is not part of the published method.
    enable_rie                   = false
    RIE_floor                    = 0.20
    restrict_archaea_to_archlips = true
    simper_top_n                 = 3000
    RIE_ceiling                  = 100.0
    fallback_RIE                 = 1.0
    archaea_kingdom              = 'Archaea'

    // Atlas spectral matching (Samrat et al. 2025 methods)
    simper_precursor_ppm         = 10
    simper_fragment_tol          = 0.02
    simper_min_cos               = 0.7
    simper_min_matched_peaks     = 4

    // Decomposition and diagnostics
    min_phylum_samples           = 2
    diagnostic_top_n             = 10

    // Decomposition methods (run all 4 in parallel; fc_weighted_bc is primary)
    decomposition_methods = 'nnls,std_bc,enriched_bc,fc_weighted_bc'  // comma-separated (schema type: string)
    primary_method        = 'fc_weighted_bc'

    // Treatment levels for the method-sensitivity table (eval/treatment_effects.tsv)
    treatment_contrast    = 'drought'  // comma-separated (schema type: string)

    // Runtime toggles
    skip_annotate = true      // demo default: off the critical path
    enable_neg    = false     // NEG mode out of scope for v0.1

    // Pipeline mode (dispatcher in main.nf routes based on this)
    mode = 'apply'            // 'process' | 'apply' | 'train'

    // Process mode: raw files -> features -> QC (stages 1-3)
    run_name                 = 'run'
    thermorawfileparser      = 'ThermoRawFileParser'
    save_mzml                = false
    mzmine_cmd               = 'mzmine'
    mzmine_user              = null
    mzmine_batch_pos         = "${projectDir}/assets/mzmine/soil_lipidomics_pos.mzbatch"
    mzmine_batch_neg         = "${projectDir}/assets/mzmine/soil_lipidomics_neg.mzbatch"
    is_targets               = "${projectDir}/assets/equisplash_targets.csv"
    is_compounds             = null
    is_rt_window             = 0.3
    qc_rt_tolerance          = 0.1
    qc_is_rsd                = 20
    qc_mass_accuracy_ppm     = 5
    qc_feature_rsd           = 30
    qc_feature_pass_fraction = 0.7
    qc_blank_ratio           = 0.2

    // Stage 4: annotation (plug-in files are optional)
    skip_annotation             = false
    annotate_lipidsearch        = null
    annotate_msdial             = null
    annotate_library            = null
    annotate_sirius             = null
    annotate_mz_ppm             = 5
    annotate_rt_window          = 0.2
    annotate_library_min_score  = 0.7
    annotate_library_min_peaks  = 4
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    local { includeConfig 'conf/local.config' }
    lisc  { includeConfig 'conf/lisc.config' }
    test  { includeConfig 'conf/test.config' }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load soillifeatlas/soillifeatlas custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// Load soillifeatlas/soillifeatlas custom profiles from different institutions.
// TODO nf-core: Optionally, you can add a pipeline-specific nf-core config at https://github.com/nf-core/configs
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/soillifeatlas.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'soillifeatlas/nf-core-soillifeatlas'
    author          = 'Rahul Samrat'
    contributors    = [
        // TODO nf-core: Update the field with the details of the contributors to your pipeline. New with Nextflow version 24.10.0
        [
            name: 'Rahul Samrat',
            affiliation: '',
            email: '',
            github: '',
            contribution: [], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/soillifeatlas/nf-core-soillifeatlas'
    description     = 'Standardized Nextflow pipeline for cross-kingdom soil lipidomics decomposition'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.0'
    version         = '0.1.0-dev'
    doi             = ''  // filled in after v0.1.0 Zenodo deposition
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
